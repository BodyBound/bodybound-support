{
  "cli": {
    "version": ">= 15.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://gemini-tattoo-gen.preview.emergentagent.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://gemini-tattoo-gen.preview.emergentagent.com"
      }
    },
    "production": {
      "channel": "production",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "resourceClass": "m-medium",
        "credentialsSource": "remote"
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://bodybound-subs.emergent.host"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6741930631",
        "bundleIdentifier": "app.emergent.tattoostencils115373ef8"
      }
    }
  }
}
